archetype (adl_version=1.4; uid=f06767d8-6671-404e-b273-73728ea33e96)
	openEHR-EHR-EHR_STATUS.generic.v1

concept
	[at0000]	-- EHR Status
language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["name"] = <"openehr-reference-content">
		["date"] = <"2026-11-19">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To give an EHR_STATUS the archetype id a CDR gives it by default, with any item structure as its other details: a tree, a list, a single item or a table, plain or defined by an archetype.">
			use = <"Use for the EHR_STATUS of an EHR that needs no structure beyond the Reference Model's: its subject, whether it is queryable and modifiable, and other details left open.">
			keywords = <"EHR status", "subject", "queryable", "modifiable">
			misuse = <"Not for data about the patient: record clinical data in compositions and who the patient is in a demographic service. Not where the other details must follow one structure: fill a slot with that structure's archetype in a template, or specialise this archetype.">
			copyright = <"© openehr-reference-content contributors">
		>
	>
	lifecycle_state = <"in_development">
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["references"] = <"CKM publishes no archetype for this class. The archetype id is the one EHRbase gives an instance of it by default, so a template on it validates what a CDR creates.">
	>

definition
	EHR_STATUS[at0000] matches {	-- EHR Status
		other_details existence matches {0..1} matches {
			ITEM_TREE[at0001] occurrences matches {0..1} matches {*}	-- Other details
			allow_archetype ITEM_TREE[at0002] occurrences matches {0..1} matches {	-- Archetyped other details tree
				include
					archetype_id/value matches {/openEHR-EHR-ITEM_TREE\..+/}
			}
			ITEM_LIST[at0003] occurrences matches {0..1} matches {*}	-- Other details list
			allow_archetype ITEM_LIST[at0004] occurrences matches {0..1} matches {	-- Archetyped other details list
				include
					archetype_id/value matches {/openEHR-EHR-ITEM_LIST\..+/}
			}
			ITEM_SINGLE[at0005] occurrences matches {0..1} matches {*}	-- Other details single item
			allow_archetype ITEM_SINGLE[at0006] occurrences matches {0..1} matches {	-- Archetyped other details single item
				include
					archetype_id/value matches {/openEHR-EHR-ITEM_SINGLE\..+/}
			}
			ITEM_TABLE[at0007] occurrences matches {0..1} matches {*}	-- Other details table
			allow_archetype ITEM_TABLE[at0008] occurrences matches {0..1} matches {	-- Archetyped other details table
				include
					archetype_id/value matches {/openEHR-EHR-ITEM_TABLE\..+/}
			}
		}
	}

