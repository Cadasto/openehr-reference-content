		["en"] = <
			items = <
				["at0000"] = <
					text = <"EHR Status">
					description = <"The status of an EHR: its subject, whether it may be queried and modified, and other details.">
				>
				["at0001"] = <
					text = <"Other details">
					description = <"Further details about the EHR status, as a tree of items.">
				>
				["at0002"] = <
					text = <"Archetyped other details tree">
					description = <"Further details about the EHR status, as a tree of items that an archetype defines.">
				>
				["at0003"] = <
					text = <"Other details list">
					description = <"Further details about the EHR status, as a list of elements.">
				>
				["at0004"] = <
					text = <"Archetyped other details list">
					description = <"Further details about the EHR status, as a list of elements that an archetype defines.">
				>
				["at0005"] = <
