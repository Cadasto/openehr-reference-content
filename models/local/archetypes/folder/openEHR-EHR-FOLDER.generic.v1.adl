archetype (adl_version=1.4; uid=335b7782-4722-4d80-bb13-259da8f06eea)
	openEHR-EHR-FOLDER.generic.v1

concept
	[at0000]	-- Folder
language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["name"] = <"openehr-reference-content">
		["date"] = <"2026-11-19">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To give a FOLDER the archetype id a CDR gives it by default, with any item structure as its details, plain or defined by an archetype, and any sub-folders and items.">
			use = <"Use for a folder of an EHR's directory, or of a demographic service's, that needs no structure beyond the Reference Model's.">
			keywords = <"folder", "directory", "episode", "grouping">
			misuse = <"Not where a folder's details must follow one structure: fill a slot with that structure's archetype in a template, or specialise this archetype. Not where its sub-folders or items have a structure of their own: specialise this archetype or author another.">
			copyright = <"© openehr-reference-content contributors">
		>
	>
	lifecycle_state = <"in_development">
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["references"] = <"CKM publishes no archetype for this class. The archetype id is the one EHRbase gives an instance of it by default, so a template on it validates what a CDR creates.">
	>

definition
	FOLDER[at0000] matches {	-- Folder
		details existence matches {0..1} matches {
			ITEM_TREE[at0001] occurrences matches {0..1} matches {*}	-- Details
			allow_archetype ITEM_TREE[at0002] occurrences matches {0..1} matches {	-- Archetyped details tree
				include
					archetype_id/value matches {/openEHR-EHR-ITEM_TREE\..+/}
			}
			ITEM_LIST[at0003] occurrences matches {0..1} matches {*}	-- Details list
			allow_archetype ITEM_LIST[at0004] occurrences matches {0..1} matches {	-- Archetyped details list
				include
					archetype_id/value matches {/openEHR-EHR-ITEM_LIST\..+/}
			}
			ITEM_SINGLE[at0005] occurrences matches {0..1} matches {*}	-- Details single item
			allow_archetype ITEM_SINGLE[at0006] occurrences matches {0..1} matches {	-- Archetyped details single item
				include
					archetype_id/value matches {/openEHR-EHR-ITEM_SINGLE\..+/}
			}
			ITEM_TABLE[at0007] occurrences matches {0..1} matches {*}	-- Details table
			allow_archetype ITEM_TABLE[at0008] occurrences matches {0..1} matches {	-- Archetyped details table
				include
					archetype_id/value matches {/openEHR-EHR-ITEM_TABLE\..+/}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Folder">
					description = <"A folder that groups versioned items of an EHR, and further folders.">
				>
				["at0001"] = <
					text = <"Details">
					description = <"Further details about the folder, as a tree of items.">
				>
				["at0002"] = <
					text = <"Archetyped details tree">
					description = <"Further details about the folder, as a tree of items that an archetype defines.">
				>
				["at0003"] = <
					text = <"Details list">
					description = <"Further details about the folder, as a list of elements.">
				>
				["at0004"] = <
					text = <"Archetyped details list">
					description = <"Further details about the folder, as a list of elements that an archetype defines.">
				>
				["at0005"] = <
					text = <"Details single item">
					description = <"Further details about the folder, as a single element.">
				>
				["at0006"] = <
					text = <"Archetyped details single item">
					description = <"Further details about the folder, as a single element that an archetype defines.">
				>
				["at0007"] = <
					text = <"Details table">
					description = <"Further details about the folder, as a table of rows.">
				>
				["at0008"] = <
					text = <"Archetyped details table">
					description = <"Further details about the folder, as a table of rows that an archetype defines.">
				>
			>
		>
	>
