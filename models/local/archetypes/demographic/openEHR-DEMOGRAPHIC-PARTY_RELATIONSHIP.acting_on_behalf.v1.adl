archetype (adl_version=1.4; uid=7069d50e-a169-473c-bbb4-023328060063)
	openEHR-DEMOGRAPHIC-PARTY_RELATIONSHIP.acting_on_behalf.v1

concept
	[at0000]	-- Acting on behalf
language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["name"] = <"openehr-reference-content">
		["date"] = <"2026-11-19">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record that an actor acts on behalf of another party, and on what authority.">
			use = <"Use in the acting party, with the actor as source: a software agent and the organisation that operates it, a representative and the person represented. The relationship is held by its source party and versioned with it; its time_validity is the period in which it is active. The archetype id is the relationship's type.">
			keywords = <"acting on behalf", "agent", "owner", "representative", "mandate", "guardian">
			misuse = <"Not for membership of a group or an organisation: use a membership.">
			copyright = <"© openehr-reference-content contributors">
		>
	>
	lifecycle_state = <"in_development">
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["references"] = <"Aligned with the HL7 FHIR R4 (4.0.1) elements Device.owner and Provenance.agent.onBehalfOf (https://hl7.org/fhir/R4/).">
	>

definition
	PARTY_RELATIONSHIP[at0000] matches {	-- Acting on behalf
		details existence matches {0..1} matches {
			ITEM_TREE[at0001] occurrences matches {1..1} matches {	-- Details
				items cardinality matches {1..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..1} matches {	-- Basis
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0003] occurrences matches {0..1} matches {	-- Comment
						value matches {
							DV_TEXT matches {*}
						}
					}
				}
			}
		}
		target matches {
			PARTY_REF matches {
				type matches {"ORGANISATION", "PERSON", "GROUP"}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Acting on behalf">
					description = <"The source actor acts on behalf of the target party, such as an agent operated by an organisation, or a person who represents another.">
				>
				["at0001"] = <
					text = <"Details">
					description = <"Data about the relationship.">
				>
				["at0002"] = <
					text = <"Basis">
					description = <"What the authority to act rests on, such as a contract, a mandate or a legal guardianship.">
				>
				["at0003"] = <
					text = <"Comment">
					description = <"A note about the relationship.">
				>
			>
		>
	>
