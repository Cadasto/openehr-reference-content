archetype (adl_version=1.4; uid=3ea6edd4-fa71-4022-ad2e-8c2216d19c6e)
	openEHR-DEMOGRAPHIC-PARTY_RELATIONSHIP.part_of.v1

concept
	[at0000]	-- Part of
language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["name"] = <"openehr-reference-content">
		["date"] = <"2026-11-19">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record that an organisation is a part of another, such as a department of a hospital, a ward of a department or a subsidiary of a company.">
			use = <"Use in the part's party, with the part as source and the organisation it belongs to as target, so each part names its parent and the hierarchy is read upwards. The relationship is held by its source party and versioned with it; its time_validity is the period in which it is active. The archetype id is the relationship's type.">
			keywords = <"part of", "hierarchy", "department", "subsidiary", "parent organisation">
			misuse = <"Not for membership of an organisation by a person, a group or an agent: use a membership. Not for a contract or an affiliation between independent organisations: use a membership of a group that stands for the network.">
			copyright = <"© openehr-reference-content contributors">
		>
	>
	lifecycle_state = <"in_development">
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["references"] = <"Derived from the relationship between an organisation and its divisions in the CKM draft openEHR-DEMOGRAPHIC-ORGANISATION.organisation.v0. Aligned with the HL7 FHIR R4 (4.0.1) element Organization.partOf (https://hl7.org/fhir/R4/).">
	>

definition
	PARTY_RELATIONSHIP[at0000] matches {	-- Part of
		details existence matches {0..1} matches {
			ITEM_TREE[at0001] occurrences matches {1..1} matches {	-- Details
				items cardinality matches {1..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..1} matches {	-- Comment
						value matches {
							DV_TEXT matches {*}
						}
					}
				}
			}
		}
		target matches {
			PARTY_REF matches {
				type matches {"ORGANISATION"}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Part of">
					description = <"The source organisation is a part of the target organisation, such as a ward of a hospital or a subsidiary of a company.">
				>
				["at0001"] = <
					text = <"Details">
					description = <"Data about the relationship.">
				>
				["at0002"] = <
					text = <"Comment">
					description = <"A note about the relationship.">
				>
			>
		>
	>
