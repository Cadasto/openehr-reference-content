archetype (adl_version=1.4; uid=bed1d1ae-9a34-44ef-818d-cdea610c0d64)
	openEHR-DEMOGRAPHIC-PERSON.generic_person.v1

concept
	[at0000]	-- Person
language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["name"] = <"openehr-reference-content">
		["date"] = <"2026-11-19">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record a person as a party in a demographic service: the person's identifiers, names, birth and death, administrative gender and contacts, and the relationships the person holds to other parties.">
			use = <"Use for any person a demographic service holds: a patient, a care provider, a contact person. The archetype carries no role: a template selects what a use needs, such as a patient record that names no one, a patient's identity, or a care provider. Names are PARTY_IDENTITYs; identifiers issued for the person go in details. A person's relationships to care providers, care teams, organisations and roles are PARTY_RELATIONSHIP archetypes in the relationships slot.">
			keywords = <"person", "patient", "care provider", "name", "identifier", "date of birth", "gender", "contact", "demographics">
			misuse = <"Not for clinical observations about the person, such as sex, gender identity, ethnicity or occupation: record those in the health record. Not for an organisation, a group or a device: use ORGANISATION, GROUP or AGENT archetypes.">
			copyright = <"© openehr-reference-content contributors">
		>
	>
	lifecycle_state = <"in_development">
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["references"] = <"Structure derived from the openEHR CKM demographic drafts (openEHR-DEMOGRAPHIC-PERSON.person.v0, PERSON.person-patient.v0, PARTY_IDENTITY.person_name.v0, ROLE.individual_provider.v0, CAPABILITY.individual_credentials.v0). Names, addresses, telecom and contact persons use the published CKM clusters openEHR-EHR-CLUSTER.structured_name.v1, address.v1, electronic_communication.v1 and person.v1. Aligned with the HL7 FHIR R4 (4.0.1) resources Patient, Practitioner and RelatedPerson (https://hl7.org/fhir/R4/).">
	>

definition
	PERSON[at0000] matches {	-- Person
		details existence matches {0..1} matches {
			ITEM_TREE[at0001] occurrences matches {1..1} matches {	-- Details
				items cardinality matches {1..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..*} matches {	-- Identifier
						value matches {
							DV_IDENTIFIER matches {*}
						}
					}
					ELEMENT[at0003] occurrences matches {0..1} matches {	-- Date of birth
						value matches {
							DV_DATE matches {*}
						}
					}
					ELEMENT[at0004] occurrences matches {0..1} matches {	-- Administrative gender
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0005,	-- Male
									at0006,	-- Female
									at0007,	-- Other
									at0008]	-- Unknown
								}
							}
						}
					}
					ELEMENT[at0009] occurrences matches {0..1} matches {	-- Deceased
						value matches {
							DV_BOOLEAN matches {*}
						}
					}
					ELEMENT[at0010] occurrences matches {0..1} matches {	-- Date and time of death
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0011] occurrences matches {0..1} matches {	-- Marital status
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0012,	-- Annulled
									at0013,	-- Divorced
									at0014,	-- Interlocutory
									at0015,	-- Legally separated
									at0016,	-- Married
									at0017,	-- Polygamous
									at0018,	-- Never married
									at0019,	-- Domestic partner
									at0020,	-- Unmarried
									at0021]	-- Widowed
								}
							}
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0022] occurrences matches {0..1} matches {	-- Multiple birth
						value matches {
							DV_BOOLEAN matches {*}
							DV_COUNT matches {*}
						}
					}
					allow_archetype CLUSTER[at0023] occurrences matches {0..1} matches {	-- Place of birth
						include
							archetype_id/value matches {/openEHR-EHR-CLUSTER\.address(-[a-zA-Z0-9_]+)*\.v1/}
					}
					CLUSTER[at0024] occurrences matches {0..*} matches {	-- Qualification
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0025] occurrences matches {1..1} matches {	-- Qualification
								value matches {
									DV_TEXT matches {*}
								}
							}
							ELEMENT[at0026] occurrences matches {0..*} matches {	-- Qualification identifier
								value matches {
									DV_IDENTIFIER matches {*}
								}
							}
							ELEMENT[at0027] occurrences matches {0..1} matches {	-- Issuer
								value matches {
									DV_TEXT matches {*}
								}
							}
							ELEMENT[at0028] occurrences matches {0..1} matches {	-- Period of validity
								value matches {
									DV_INTERVAL<DV_DATE> matches {*}
								}
							}
						}
					}
					allow_archetype CLUSTER[at0029] occurrences matches {0..*} matches {	-- Contact person
						include
							archetype_id/value matches {/openEHR-EHR-CLUSTER\.person(-[a-zA-Z0-9_]+)*\.v1/}
					}
					allow_archetype CLUSTER[at0030] occurrences matches {0..*} matches {	-- Additional details
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
		identities cardinality matches {1..*; unordered} matches {
			PARTY_IDENTITY[at0031] occurrences matches {0..*} matches {	-- Person name
				name matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0032,	-- Usual
							at0033,	-- Official
							at0034,	-- Temporary
							at0035,	-- Nickname
							at0036,	-- Anonymous
							at0037,	-- Old
							at0038]	-- Maiden
						}
					}
					DV_TEXT matches {*}
				}
				details matches {
					ITEM_TREE[at0039] occurrences matches {1..1} matches {	-- Name details
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0040] occurrences matches {0..1} matches {	-- Full name
								value matches {
									DV_TEXT matches {*}
								}
							}
							allow_archetype CLUSTER[at0041] occurrences matches {0..1} matches {	-- Structured name
								include
									archetype_id/value matches {/openEHR-EHR-CLUSTER\.structured_name(-[a-zA-Z0-9_]+)*\.v1/}
							}
							ELEMENT[at0042] occurrences matches {0..1} matches {	-- Period of use
								value matches {
									DV_INTERVAL<DV_DATE> matches {*}
								}
							}
						}
					}
				}
			}
			PARTY_IDENTITY[at0043] occurrences matches {0..*} matches {	-- Pseudonym
				details matches {
					ITEM_TREE[at0044] occurrences matches {1..1} matches {	-- Pseudonym details
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0045] occurrences matches {1..1} matches {	-- Pseudonym
								value matches {
									DV_TEXT matches {*}
								}
							}
						}
					}
				}
			}
		}
		contacts existence matches {0..1} cardinality matches {0..*; unordered} matches {
			CONTACT[at0046] occurrences matches {0..*} matches {	-- Contact
				name matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0047,	-- Home
							at0048,	-- Work
							at0049,	-- Temporary
							at0050,	-- Old
							at0051]	-- Billing
						}
					}
					DV_TEXT matches {*}
				}
				addresses cardinality matches {1..*; unordered} matches {
					ADDRESS[at0052] occurrences matches {0..*} matches {	-- Postal address
						details matches {
							ITEM_TREE[at0053] occurrences matches {1..1} matches {	-- Postal address details
								items cardinality matches {1..1; unordered} matches {
									allow_archetype CLUSTER[at0054] occurrences matches {1..1} matches {	-- Address
										include
											archetype_id/value matches {/openEHR-EHR-CLUSTER\.address(-[a-zA-Z0-9_]+)*\.v1/}
									}
								}
							}
						}
					}
					ADDRESS[at0055] occurrences matches {0..*} matches {	-- Electronic communication
						details matches {
							ITEM_TREE[at0056] occurrences matches {1..1} matches {	-- Electronic communication details
								items cardinality matches {1..1; unordered} matches {
									allow_archetype CLUSTER[at0057] occurrences matches {1..1} matches {	-- Electronic communication
										include
											archetype_id/value matches {/openEHR-EHR-CLUSTER\.electronic_communication(-[a-zA-Z0-9_]+)*\.v1/}
									}
								}
							}
						}
					}
				}
			}
		}
		relationships existence matches {0..1} cardinality matches {0..*; unordered} matches {
			allow_archetype PARTY_RELATIONSHIP[at0058] occurrences matches {0..*} matches {	-- Relationship
				include
					archetype_id/value matches {/openEHR-DEMOGRAPHIC-PARTY_RELATIONSHIP\.care_relationship(-[a-zA-Z0-9_]+)*\.v1/}
					archetype_id/value matches {/openEHR-DEMOGRAPHIC-PARTY_RELATIONSHIP\.party_membership(-[a-zA-Z0-9_]+)*\.v1/}
					archetype_id/value matches {/openEHR-DEMOGRAPHIC-PARTY_RELATIONSHIP\.role_assignment(-[a-zA-Z0-9_]+)*\.v1/}
					archetype_id/value matches {/openEHR-DEMOGRAPHIC-PARTY_RELATIONSHIP\.acting_on_behalf(-[a-zA-Z0-9_]+)*\.v1/}
			}
		}
		languages existence matches {0..1} cardinality matches {0..*; ordered} matches {
			DV_TEXT matches {*}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Person">
					description = <"A human being recorded as a party in a demographic service, independent of any role the person plays.">
				>
				["at0001"] = <
					text = <"Details">
					description = <"Data about the person other than names and contacts.">
				>
				["at0002"] = <
					text = <"Identifier">
					description = <"An identifier issued for the person, such as a patient number, a pseudonym, a national person number, a passport number or a professional registration number.">
					comment = <"Record the kind of identifier in type (for example a code of HL7 v2 table 0203: MR, PI, ANON, NI, PPN, DL, PRN, NPI, LN), the authority whose scheme it belongs to in issuer, and the organisation that assigned it in assigner. Corresponds to FHIR Patient.identifier and Practitioner.identifier.">
				>
				["at0003"] = <
					text = <"Date of birth">
					description = <"The date on which the person was born.">
					comment = <"A partial date, such as the year alone, may be recorded. Corresponds to FHIR birthDate.">
				>
				["at0004"] = <
					text = <"Administrative gender">
					description = <"The gender of the person used for administrative purposes.">
					comment = <"The four codes match FHIR AdministrativeGender one to one. It is not an observation of sex or of gender identity; those belong in the health record.">
				>
				["at0005"] = <
					text = <"Male">
					description = <"Male. FHIR AdministrativeGender code male.">
				>
				["at0006"] = <
					text = <"Female">
					description = <"Female. FHIR AdministrativeGender code female.">
				>
				["at0007"] = <
					text = <"Other">
					description = <"Other than male or female. FHIR AdministrativeGender code other.">
				>
				["at0008"] = <
					text = <"Unknown">
					description = <"The gender is not known. FHIR AdministrativeGender code unknown.">
				>
				["at0009"] = <
					text = <"Deceased">
					description = <"Whether the person is known to have died.">
					comment = <"Corresponds to FHIR deceasedBoolean.">
				>
				["at0010"] = <
					text = <"Date and time of death">
					description = <"When the person died, as precisely as it is known.">
					comment = <"Corresponds to FHIR deceasedDateTime.">
				>
				["at0011"] = <
					text = <"Marital status">
					description = <"The person's marital or civil status.">
					comment = <"The codes are those of the FHIR R4 marital-status value set. Corresponds to FHIR Patient.maritalStatus.">
				>
				["at0012"] = <
					text = <"Annulled">
					description = <"The marriage was declared never to have existed. HL7 v3 MaritalStatus code A.">
				>
				["at0013"] = <
					text = <"Divorced">
					description = <"The marriage was dissolved. HL7 v3 MaritalStatus code D.">
				>
				["at0014"] = <
					text = <"Interlocutory">
					description = <"A divorce is subject to a final decree. HL7 v3 MaritalStatus code I.">
				>
				["at0015"] = <
					text = <"Legally separated">
					description = <"Legally separated. HL7 v3 MaritalStatus code L.">
				>
				["at0016"] = <
					text = <"Married">
					description = <"A current marriage contract is active. HL7 v3 MaritalStatus code M.">
				>
				["at0017"] = <
					text = <"Polygamous">
					description = <"More than one current spouse. HL7 v3 MaritalStatus code P.">
				>
				["at0018"] = <
					text = <"Never married">
					description = <"No marriage contract has ever been entered. HL7 v3 MaritalStatus code S.">
				>
				["at0019"] = <
					text = <"Domestic partner">
					description = <"A person declares that a domestic partner relationship exists. HL7 v3 MaritalStatus code T.">
				>
				["at0020"] = <
					text = <"Unmarried">
					description = <"Currently not in a marriage contract. HL7 v3 MaritalStatus code U.">
				>
				["at0021"] = <
					text = <"Widowed">
					description = <"The spouse has died. HL7 v3 MaritalStatus code W.">
				>
				["at0022"] = <
					text = <"Multiple birth">
					description = <"Whether the person was born as part of a multiple birth, or the person's position in the birth order.">
					comment = <"Record a Boolean, or a count for the birth order. Corresponds to FHIR multipleBirth[x].">
				>
				["at0023"] = <
					text = <"Place of birth">
					description = <"The place where the person was born.">
					comment = <"Corresponds to the FHIR patient-birthPlace extension.">
				>
				["at0024"] = <
					text = <"Qualification">
					description = <"A qualification, licence or certification the person holds, such as a professional registration or an academic degree.">
					comment = <"Corresponds to FHIR Practitioner.qualification.">
				>
				["at0025"] = <
					text = <"Qualification">
					description = <"The name or code of the qualification.">
					comment = <"Coding is preferred, for example with HL7 v2 table 0360 or a national register's codes.">
				>
				["at0026"] = <
					text = <"Qualification identifier">
					description = <"An identifier of the qualification, such as a registration number.">
				>
				["at0027"] = <
					text = <"Issuer">
					description = <"The organisation that issued the qualification.">
				>
				["at0028"] = <
					text = <"Period of validity">
					description = <"The period in which the qualification is valid.">
				>
				["at0029"] = <
					text = <"Contact person">
					description = <"A person to contact about this person, such as next of kin or an emergency contact.">
					comment = <"Record how the contact relates to this person in the cluster's Role element, for example with HL7 v2 table 0131 (C emergency contact, N next of kin). Corresponds to FHIR Patient.contact.">
				>
				["at0030"] = <
					text = <"Additional details">
					description = <"Further details about the person that a particular use needs.">
				>
				["at0031"] = <
					text = <"Person name">
					description = <"A name by which the person is known.">
					comment = <"The name of the PARTY_IDENTITY is its purpose: the use of the name. The codes match FHIR NameUse.">
				>
				["at0032"] = <
					text = <"Usual">
					description = <"The name the person is usually known by. FHIR NameUse code usual.">
				>
				["at0033"] = <
					text = <"Official">
					description = <"The name registered officially, such as on a birth certificate or passport. FHIR NameUse code official.">
				>
				["at0034"] = <
					text = <"Temporary">
					description = <"A name used for a limited period. FHIR NameUse code temp.">
				>
				["at0035"] = <
					text = <"Nickname">
					description = <"An informal name the person uses. FHIR NameUse code nickname.">
				>
				["at0036"] = <
					text = <"Anonymous">
					description = <"A name used to keep the person anonymous. FHIR NameUse code anonymous.">
				>
				["at0037"] = <
					text = <"Old">
					description = <"A name no longer in use. FHIR NameUse code old.">
				>
				["at0038"] = <
					text = <"Maiden">
					description = <"A name used before marriage. FHIR NameUse code maiden.">
				>
				["at0039"] = <
					text = <"Name details">
					description = <"The name and its parts.">
				>
				["at0040"] = <
					text = <"Full name">
					description = <"The whole name, as it is displayed.">
					comment = <"Corresponds to FHIR HumanName.text.">
				>
				["at0041"] = <
					text = <"Structured name">
					description = <"The name in its parts.">
				>
				["at0042"] = <
					text = <"Period of use">
					description = <"The period in which the name was or is in use.">
					comment = <"Corresponds to FHIR HumanName.period.">
				>
				["at0043"] = <
					text = <"Pseudonym">
					description = <"A designation by which the person is known in place of a name.">
					comment = <"For a person whose name is held elsewhere, for example where the identity is kept apart from the health record.">
				>
				["at0044"] = <
					text = <"Pseudonym details">
					description = <"The pseudonym.">
				>
				["at0045"] = <
					text = <"Pseudonym">
					description = <"A designation that does not by itself identify the person, such as a patient number or a randomly assigned label.">
				>
				["at0046"] = <
					text = <"Contact">
					description = <"A group of addresses at which the person can be reached for one purpose, with the period in which they are valid.">
					comment = <"The name of the CONTACT is its purpose. The codes match FHIR AddressUse and ContactPointUse; the CONTACT's time_validity is the period of use.">
				>
				["at0047"] = <
					text = <"Home">
					description = <"The addresses of the party's home. Corresponds to FHIR use home.">
				>
				["at0048"] = <
					text = <"Work">
					description = <"The addresses at which the party works. Corresponds to FHIR use work.">
				>
				["at0049"] = <
					text = <"Temporary">
					description = <"Addresses in use for a limited period. Corresponds to FHIR use temp.">
				>
				["at0050"] = <
					text = <"Old">
					description = <"Addresses that are no longer in use. Corresponds to FHIR use old.">
				>
				["at0051"] = <
					text = <"Billing">
					description = <"Addresses for invoices and payment. Corresponds to FHIR AddressUse billing.">
				>
				["at0052"] = <
					text = <"Postal address">
					description = <"A physical or postal address.">
				>
				["at0053"] = <
					text = <"Postal address details">
					description = <"The structure that holds the address.">
				>
				["at0054"] = <
					text = <"Address">
					description = <"The address.">
				>
				["at0055"] = <
					text = <"Electronic communication">
					description = <"An electronic address, such as a telephone number or an email address.">
				>
				["at0056"] = <
					text = <"Electronic communication details">
					description = <"The structure that holds the electronic address.">
				>
				["at0057"] = <
					text = <"Electronic communication">
					description = <"The electronic address.">
				>
				["at0058"] = <
					text = <"Relationship">
					description = <"A relationship the person holds to another party.">
				>
			>
		>
	>
