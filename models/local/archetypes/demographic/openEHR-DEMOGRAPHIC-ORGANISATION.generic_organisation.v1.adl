archetype (adl_version=1.4; uid=f98a21dc-0e98-427c-a5fc-a8512dd98e66)
	openEHR-DEMOGRAPHIC-ORGANISATION.generic_organisation.v1

concept
	[at0000]	-- Organisation
language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["name"] = <"openehr-reference-content">
		["date"] = <"2026-11-19">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record an organisation as a party in a demographic service: its identifiers, names, type, contacts and contact persons, and the relationships it holds to other parties, such as the organisation it is part of.">
			use = <"Use for any organisation with a legal or administrative standing that a demographic service holds: a hospital, a practice, a department or a ward, a laboratory, an insurer, a public body. Names are PARTY_IDENTITYs named by their kind; identifiers go in details. A part of an organisation records the organisation it is part of as a part of relationship, so a hierarchy is read from its smallest parts upwards.">
			keywords = <"organisation", "organization", "healthcare provider", "hospital", "department", "practice", "insurer", "demographics">
			misuse = <"Not for an informal or functional group of parties, such as a care team or a household: use a GROUP. Not for the location where care takes place, such as a room or a bed. Not for an organisation mentioned in clinical content: use the CKM Organisation cluster in the health record.">
			copyright = <"© openehr-reference-content contributors">
		>
	>
	lifecycle_state = <"in_development">
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["references"] = <"Structure derived from the openEHR CKM demographic drafts openEHR-DEMOGRAPHIC-ORGANISATION.organisation.v0 and PARTY_IDENTITY.organisation_name.v0, after ISO/DTS 27527:2007 Provider Identification. Addresses, telecom and contact persons use the published CKM clusters openEHR-EHR-CLUSTER.address.v1, electronic_communication.v1 and person.v1. Aligned with the HL7 FHIR R4 (4.0.1) resource Organization (https://hl7.org/fhir/R4/).">
	>

definition
	ORGANISATION[at0000] matches {	-- Organisation
		details existence matches {0..1} matches {
			ITEM_TREE[at0001] occurrences matches {1..1} matches {	-- Details
				items cardinality matches {1..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..*} matches {	-- Identifier
						value matches {
							DV_IDENTIFIER matches {*}
						}
					}
					ELEMENT[at0003] occurrences matches {0..*} matches {	-- Organisation type
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0004,	-- Healthcare provider
									at0005,	-- Hospital department
									at0006,	-- Organisational team
									at0007,	-- Government
									at0008,	-- Insurance company
									at0009,	-- Payer
									at0010,	-- Educational institute
									at0011,	-- Religious institution
									at0012,	-- Clinical research sponsor
									at0013,	-- Community group
									at0014,	-- Non-healthcare business or corporation
									at0015]	-- Other
								}
							}
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0016] occurrences matches {0..1} matches {	-- Active
						value matches {
							DV_BOOLEAN matches {*}
						}
					}
					ELEMENT[at0017] occurrences matches {0..1} matches {	-- Description
						value matches {
							DV_TEXT matches {*}
						}
					}
					allow_archetype CLUSTER[at0018] occurrences matches {0..*} matches {	-- Contact person
						include
							archetype_id/value matches {/openEHR-EHR-CLUSTER\.person(-[a-zA-Z0-9_]+)*\.v1/}
					}
					allow_archetype CLUSTER[at0019] occurrences matches {0..*} matches {	-- Additional details
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
		identities cardinality matches {1..*; unordered} matches {
			PARTY_IDENTITY[at0020] occurrences matches {1..*} matches {	-- Organisation name
				name matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0021,	-- Enterprise name
							at0022,	-- Business name
							at0023,	-- Locally used name
							at0024,	-- Abbreviated name
							at0025,	-- Organisational unit/section/division name
							at0026,	-- Service location name
							at0027,	-- Other
							at0028]	-- Unknown
						}
					}
					DV_TEXT matches {*}
				}
				details matches {
					ITEM_TREE[at0029] occurrences matches {1..1} matches {	-- Name details
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0030] occurrences matches {1..1} matches {	-- Name
								value matches {
									DV_TEXT matches {*}
								}
							}
						}
					}
				}
			}
		}
		contacts existence matches {0..1} cardinality matches {0..*; unordered} matches {
			CONTACT[at0031] occurrences matches {0..*} matches {	-- Contact
				name matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0032,	-- Work
							at0033,	-- Temporary
							at0034,	-- Old
							at0035]	-- Billing
						}
					}
					DV_TEXT matches {*}
				}
				addresses cardinality matches {1..*; unordered} matches {
					ADDRESS[at0036] occurrences matches {0..*} matches {	-- Postal address
						details matches {
							ITEM_TREE[at0037] occurrences matches {1..1} matches {	-- Postal address details
								items cardinality matches {1..1; unordered} matches {
									allow_archetype CLUSTER[at0038] occurrences matches {1..1} matches {	-- Address
										include
											archetype_id/value matches {/openEHR-EHR-CLUSTER\.address(-[a-zA-Z0-9_]+)*\.v1/}
									}
								}
							}
						}
					}
					ADDRESS[at0039] occurrences matches {0..*} matches {	-- Electronic communication
						details matches {
							ITEM_TREE[at0040] occurrences matches {1..1} matches {	-- Electronic communication details
								items cardinality matches {1..1; unordered} matches {
									allow_archetype CLUSTER[at0041] occurrences matches {1..1} matches {	-- Electronic communication
										include
											archetype_id/value matches {/openEHR-EHR-CLUSTER\.electronic_communication(-[a-zA-Z0-9_]+)*\.v1/}
									}
								}
							}
						}
					}
				}
			}
		}
		relationships existence matches {0..1} cardinality matches {0..*; unordered} matches {
			allow_archetype PARTY_RELATIONSHIP[at0042] occurrences matches {0..*} matches {	-- Relationship
				include
					archetype_id/value matches {/openEHR-DEMOGRAPHIC-PARTY_RELATIONSHIP\.part_of(-[a-zA-Z0-9_]+)*\.v1/}
					archetype_id/value matches {/openEHR-DEMOGRAPHIC-PARTY_RELATIONSHIP\.party_membership(-[a-zA-Z0-9_]+)*\.v1/}
					archetype_id/value matches {/openEHR-DEMOGRAPHIC-PARTY_RELATIONSHIP\.role_assignment(-[a-zA-Z0-9_]+)*\.v1/}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Organisation">
					description = <"An organisation with a legal or administrative standing, such as a hospital, a practice, a department of either, an insurer or a public body.">
				>
				["at0001"] = <
					text = <"Details">
					description = <"Data about the organisation other than names and contacts.">
				>
				["at0002"] = <
					text = <"Identifier">
					description = <"An identifier issued for the organisation, such as a national provider register number, a chamber of commerce number or a tax number.">
					comment = <"Record the kind of identifier in type (for example HL7 v2 table 0203 code XX, organisation identifier), the authority whose scheme it belongs to in issuer, and the organisation that assigned it in assigner. Corresponds to FHIR Organization.identifier.">
				>
				["at0003"] = <
					text = <"Organisation type">
					description = <"The kind of organisation.">
					comment = <"The codes match the FHIR R4 organization-type value set. Corresponds to FHIR Organization.type.">
				>
				["at0004"] = <
					text = <"Healthcare provider">
					description = <"An organisation that provides healthcare services. FHIR organization-type code prov.">
				>
				["at0005"] = <
					text = <"Hospital department">
					description = <"A department or ward within a hospital. FHIR organization-type code dept.">
				>
				["at0006"] = <
					text = <"Organisational team">
					description = <"A team of practitioners that performs a specific function within an organisation. FHIR organization-type code team.">
				>
				["at0007"] = <
					text = <"Government">
					description = <"A political body, such as a national, a regional or a local government. FHIR organization-type code govt.">
				>
				["at0008"] = <
					text = <"Insurance company">
					description = <"A company that provides insurance, which may include healthcare. FHIR organization-type code ins.">
				>
				["at0009"] = <
					text = <"Payer">
					description = <"An organisation that processes claims or pays providers on behalf of patients. FHIR organization-type code pay.">
				>
				["at0010"] = <
					text = <"Educational institute">
					description = <"An institution that provides education or research facilities. FHIR organization-type code edu.">
				>
				["at0011"] = <
					text = <"Religious institution">
					description = <"An organisation that is part of a religious institution. FHIR organization-type code reli.">
				>
				["at0012"] = <
					text = <"Clinical research sponsor">
					description = <"A pharmaceutical or clinical research sponsor. FHIR organization-type code crs.">
				>
				["at0013"] = <
					text = <"Community group">
					description = <"An unincorporated community group. FHIR organization-type code cg.">
				>
				["at0014"] = <
					text = <"Non-healthcare business or corporation">
					description = <"A registered business or corporation not of another type. FHIR organization-type code bus.">
				>
				["at0015"] = <
					text = <"Other">
					description = <"Another kind of organisation. FHIR organization-type code other.">
				>
				["at0016"] = <
					text = <"Active">
					description = <"Whether the organisation's record is in use.">
					comment = <"Corresponds to FHIR Organization.active.">
				>
				["at0017"] = <
					text = <"Description">
					description = <"A description of the organisation and what it does.">
				>
				["at0018"] = <
					text = <"Contact person">
					description = <"A person to contact at the organisation, such as for billing or for administration.">
					comment = <"Record the purpose of the contact in the cluster's Role element, for example with the FHIR contactentity-type codes (BILL, ADMIN, HR, PAYOR, PATINF, PRESS). Corresponds to FHIR Organization.contact.">
				>
				["at0019"] = <
					text = <"Additional details">
					description = <"Further details about the organisation that a particular use needs.">
				>
				["at0020"] = <
					text = <"Organisation name">
					description = <"A name by which the organisation is known.">
					comment = <"The name of the PARTY_IDENTITY is the kind of name. The kinds are those of the CKM draft openEHR-DEMOGRAPHIC-PARTY_IDENTITY.organisation_name.v0, from ISO/DTS 27527 provider identification.">
				>
				["at0021"] = <
					text = <"Enterprise name">
					description = <"The complete name of the organisation, usually the same as its registered name. Corresponds to FHIR Organization.name.">
				>
				["at0022"] = <
					text = <"Business name">
					description = <"A name used for trading. Corresponds to FHIR Organization.alias.">
				>
				["at0023"] = <
					text = <"Locally used name">
					description = <"A name the organisation is known by locally, other than its registered or business name. Corresponds to FHIR Organization.alias.">
				>
				["at0024"] = <
					text = <"Abbreviated name">
					description = <"A short or abbreviated name. Corresponds to FHIR Organization.alias.">
				>
				["at0025"] = <
					text = <"Organisational unit/section/division name">
					description = <"The name of a unit, a section or a division that has an identity of its own within the organisation.">
				>
				["at0026"] = <
					text = <"Service location name">
					description = <"A name of which the location of a service is an important part, such as a mobile unit at a named site.">
				>
				["at0027"] = <
					text = <"Other">
					description = <"A name that is none of the kinds above.">
				>
				["at0028"] = <
					text = <"Unknown">
					description = <"A name of an unknown kind.">
				>
				["at0029"] = <
					text = <"Name details">
					description = <"The name.">
				>
				["at0030"] = <
					text = <"Name">
					description = <"The name of the organisation, as it is displayed.">
				>
				["at0031"] = <
					text = <"Contact">
					description = <"A group of addresses at which the organisation can be reached for one purpose, with the period in which they are valid.">
					comment = <"The name of the CONTACT is its purpose. The codes match FHIR AddressUse and ContactPointUse, without home, which FHIR does not allow for an organisation; the CONTACT's time_validity is the period of use. Corresponds to FHIR Organization.address and Organization.telecom.">
				>
				["at0032"] = <
					text = <"Work">
					description = <"The addresses at which the organisation works and can be reached. Corresponds to FHIR use work.">
				>
				["at0033"] = <
					text = <"Temporary">
					description = <"Addresses in use for a limited period. Corresponds to FHIR use temp.">
				>
				["at0034"] = <
					text = <"Old">
					description = <"Addresses that are no longer in use. Corresponds to FHIR use old.">
				>
				["at0035"] = <
					text = <"Billing">
					description = <"Addresses for invoices and payment. Corresponds to FHIR AddressUse billing.">
				>
				["at0036"] = <
					text = <"Postal address">
					description = <"A physical or postal address.">
				>
				["at0037"] = <
					text = <"Postal address details">
					description = <"The structure that holds the address.">
				>
				["at0038"] = <
					text = <"Address">
					description = <"The address.">
				>
				["at0039"] = <
					text = <"Electronic communication">
					description = <"An electronic address, such as a telephone number or an email address.">
				>
				["at0040"] = <
					text = <"Electronic communication details">
					description = <"The structure that holds the electronic address.">
				>
				["at0041"] = <
					text = <"Electronic communication">
					description = <"The electronic address.">
				>
				["at0042"] = <
					text = <"Relationship">
					description = <"A relationship the organisation holds to another party, such as the organisation it is part of.">
					comment = <"An organisation records the organisation it is part of, not its parts: a department holds its relationship to its hospital.">
				>
			>
		>
	>
