archetype (adl_version=1.4; uid=c6b91a62-edd9-4921-b3da-f8f3a639873a)
	openEHR-DEMOGRAPHIC-PARTY_RELATIONSHIP.care_relationship.v1

concept
	[at0000]	-- Care relationship
language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["name"] = <"openehr-reference-content">
		["date"] = <"2026-11-19">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record that a patient is in the care of a care provider, a care team or an organisation, and in which part.">
			use = <"Use in the patient's party, with the patient as source. The relationship is held by its source party and versioned with it; its time_validity is the period in which it is active. The archetype id is the relationship's type. Read from the target, the care relationships are a care provider's or a team's patients.">
			keywords = <"care relationship", "caseload", "care team", "general practitioner", "patient">
			misuse = <"Not for a family or social relationship between persons. Not for a care provider's membership of a team: use a membership.">
			copyright = <"© openehr-reference-content contributors">
		>
	>
	lifecycle_state = <"in_development">
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["references"] = <"Derived from the provider relationship of the CKM draft openEHR-DEMOGRAPHIC-PERSON.person-patient.v0. Aligned with the HL7 FHIR R4 (4.0.1) elements Patient.generalPractitioner and Patient.managingOrganization and the resource CareTeam (https://hl7.org/fhir/R4/).">
	>

definition
	PARTY_RELATIONSHIP[at0000] matches {	-- Care relationship
		details existence matches {0..1} matches {
			ITEM_TREE[at0001] occurrences matches {1..1} matches {	-- Details
				items cardinality matches {1..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..1} matches {	-- Care relationship type
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0003,	-- Primary care provider
									at0004,	-- Responsible care provider
									at0005,	-- Care team
									at0006,	-- Case manager
									at0007]	-- Managing organisation
								}
							}
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0008] occurrences matches {0..*} matches {	-- Reason
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0009] occurrences matches {0..1} matches {	-- Comment
						value matches {
							DV_TEXT matches {*}
						}
					}
				}
			}
		}
		target matches {
			PARTY_REF matches {
				type matches {"PERSON", "GROUP", "ORGANISATION"}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Care relationship">
					description = <"The source party, usually a patient, is in the care of the target party: a care provider, a care team or an organisation.">
				>
				["at0001"] = <
					text = <"Details">
					description = <"Data about the relationship.">
				>
				["at0002"] = <
					text = <"Care relationship type">
					description = <"The part the target plays in the source party's care.">
				>
				["at0003"] = <
					text = <"Primary care provider">
					description = <"The target is the source party's primary care provider, such as a general practitioner. Corresponds to FHIR Patient.generalPractitioner.">
				>
				["at0004"] = <
					text = <"Responsible care provider">
					description = <"The target is responsible for the source party's care.">
				>
				["at0005"] = <
					text = <"Care team">
					description = <"The target is a care team that cares for the source party. Corresponds to FHIR CareTeam.subject.">
				>
				["at0006"] = <
					text = <"Case manager">
					description = <"The target coordinates the source party's care across providers.">
				>
				["at0007"] = <
					text = <"Managing organisation">
					description = <"The target is the organisation that manages the source party's care and record. Corresponds to FHIR Patient.managingOrganization.">
				>
				["at0008"] = <
					text = <"Reason">
					description = <"Why the care relationship exists, such as the condition or the referral it follows.">
				>
				["at0009"] = <
					text = <"Comment">
					description = <"A note about the relationship.">
				>
			>
		>
	>
