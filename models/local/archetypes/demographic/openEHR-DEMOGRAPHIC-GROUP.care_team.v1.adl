archetype (adl_version=1.4; uid=348477f1-b9d4-49e9-b7e1-81d144e12368)
	openEHR-DEMOGRAPHIC-GROUP.care_team.v1

concept
	[at0000]	-- Care team
language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["name"] = <"openehr-reference-content">
		["date"] = <"2026-11-19">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record a care team: a group of care providers, and possibly others, who plan and coordinate the care of one or more patients.">
			use = <"Use for a care team as a party in a demographic service. The team's members and patients are not listed in the team: each member records a membership relationship to the team, and each patient a care relationship to it, so the team is the target of both.">
			keywords = <"care team", "team", "group", "multidisciplinary team", "demographics">
			misuse = <"Not for an organisation with a legal or administrative standing: use an ORGANISATION. Not for a household or another informal group of persons who are not organised around care.">
			copyright = <"© openehr-reference-content contributors">
		>
	>
	lifecycle_state = <"in_development">
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["references"] = <"Aligned with the HL7 FHIR R4 (4.0.1) resource CareTeam (https://hl7.org/fhir/R4/); the categories are its care-team-category codes, bound to LOINC.">
	>

definition
	GROUP[at0000] matches {	-- Care team
		details existence matches {0..1} matches {
			ITEM_TREE[at0001] occurrences matches {1..1} matches {	-- Details
				items cardinality matches {1..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..*} matches {	-- Identifier
						value matches {
							DV_IDENTIFIER matches {*}
						}
					}
					ELEMENT[at0003] occurrences matches {0..1} matches {	-- Status
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0004,	-- Proposed
									at0005,	-- Active
									at0006,	-- Suspended
									at0007,	-- Inactive
									at0008]	-- Entered in error
								}
							}
						}
					}
					ELEMENT[at0009] occurrences matches {0..*} matches {	-- Category
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0010,	-- Event-focused care team
									at0011,	-- Encounter-focused care team
									at0012,	-- Episode of care-focused care team
									at0013,	-- Condition-focused care team
									at0014,	-- Longitudinal care-coordination focused care team
									at0015,	-- Home and community based services (HCBS)-focused care team
									at0016,	-- Clinical research-focused care team
									at0017]	-- Public health-focused care team
								}
							}
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0018] occurrences matches {0..1} matches {	-- Period
						value matches {
							DV_INTERVAL<DV_DATE_TIME> matches {*}
						}
					}
					ELEMENT[at0019] occurrences matches {0..*} matches {	-- Reason
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0020] occurrences matches {0..*} matches {	-- Comment
						value matches {
							DV_TEXT matches {*}
						}
					}
					allow_archetype CLUSTER[at0021] occurrences matches {0..*} matches {	-- Additional details
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
		identities cardinality matches {1..*; unordered} matches {
			PARTY_IDENTITY[at0022] occurrences matches {1..*} matches {	-- Team name
				details matches {
					ITEM_TREE[at0023] occurrences matches {1..1} matches {	-- Name details
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0024] occurrences matches {1..1} matches {	-- Name
								value matches {
									DV_TEXT matches {*}
								}
							}
						}
					}
				}
			}
		}
		contacts existence matches {0..1} cardinality matches {0..*; unordered} matches {
			CONTACT[at0025] occurrences matches {0..*} matches {	-- Contact
				addresses cardinality matches {1..*; unordered} matches {
					ADDRESS[at0026] occurrences matches {0..*} matches {	-- Electronic communication
						details matches {
							ITEM_TREE[at0027] occurrences matches {1..1} matches {	-- Electronic communication details
								items cardinality matches {1..1; unordered} matches {
									allow_archetype CLUSTER[at0028] occurrences matches {1..1} matches {	-- Electronic communication
										include
											archetype_id/value matches {/openEHR-EHR-CLUSTER\.electronic_communication(-[a-zA-Z0-9_]+)*\.v1/}
									}
								}
							}
						}
					}
				}
			}
		}
		relationships existence matches {0..1} cardinality matches {0..*; unordered} matches {
			allow_archetype PARTY_RELATIONSHIP[at0029] occurrences matches {0..*} matches {	-- Relationship
				include
					archetype_id/value matches {/openEHR-DEMOGRAPHIC-PARTY_RELATIONSHIP\.party_membership(-[a-zA-Z0-9_]+)*\.v1/}
			}
		}
	}

ontology
	terminologies_available = <"LOINC">
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Care team">
					description = <"A group of care providers, and possibly others, who plan and coordinate the care of one or more patients.">
				>
				["at0001"] = <
					text = <"Details">
					description = <"Data about the care team.">
				>
				["at0002"] = <
					text = <"Identifier">
					description = <"An identifier of the care team.">
					comment = <"Corresponds to FHIR CareTeam.identifier.">
				>
				["at0003"] = <
					text = <"Status">
					description = <"The state of the care team.">
					comment = <"The codes match FHIR R4 CareTeamStatus.">
				>
				["at0004"] = <
					text = <"Proposed">
					description = <"The team is planned but not yet active. FHIR CareTeamStatus code proposed.">
				>
				["at0005"] = <
					text = <"Active">
					description = <"The team is active. FHIR CareTeamStatus code active.">
				>
				["at0006"] = <
					text = <"Suspended">
					description = <"The team is paused. FHIR CareTeamStatus code suspended.">
				>
				["at0007"] = <
					text = <"Inactive">
					description = <"The team no longer acts. FHIR CareTeamStatus code inactive.">
				>
				["at0008"] = <
					text = <"Entered in error">
					description = <"The team was recorded in error. FHIR CareTeamStatus code entered-in-error.">
				>
				["at0009"] = <
					text = <"Category">
					description = <"The kind of care team.">
					comment = <"The codes are those of the FHIR R4 care-team-category value set, bound to LOINC.">
				>
				["at0010"] = <
					text = <"Event-focused care team">
					description = <"A team for one event, such as a procedure.">
				>
				["at0011"] = <
					text = <"Encounter-focused care team">
					description = <"A team for one encounter.">
				>
				["at0012"] = <
					text = <"Episode of care-focused care team">
					description = <"A team for an episode of care.">
				>
				["at0013"] = <
					text = <"Condition-focused care team">
					description = <"A team for a condition, such as a chronic disease.">
				>
				["at0014"] = <
					text = <"Longitudinal care-coordination focused care team">
					description = <"A team that coordinates care over time.">
				>
				["at0015"] = <
					text = <"Home and community based services (HCBS)-focused care team">
					description = <"A team for home and community based services.">
				>
				["at0016"] = <
					text = <"Clinical research-focused care team">
					description = <"A team for a clinical research study.">
				>
				["at0017"] = <
					text = <"Public health-focused care team">
					description = <"A team for a public health purpose.">
				>
				["at0018"] = <
					text = <"Period">
					description = <"The period in which the team is or was active.">
					comment = <"Corresponds to FHIR CareTeam.period.">
				>
				["at0019"] = <
					text = <"Reason">
					description = <"Why the team exists, such as the condition it addresses.">
					comment = <"Corresponds to FHIR CareTeam.reasonCode.">
				>
				["at0020"] = <
					text = <"Comment">
					description = <"A note about the team.">
					comment = <"Corresponds to FHIR CareTeam.note.">
				>
				["at0021"] = <
					text = <"Additional details">
					description = <"Further details about the team that a particular use needs.">
				>
				["at0022"] = <
					text = <"Team name">
					description = <"The name by which the team is known.">
				>
				["at0023"] = <
					text = <"Name details">
					description = <"The name.">
				>
				["at0024"] = <
					text = <"Name">
					description = <"The name of the team, as it is displayed.">
				>
				["at0025"] = <
					text = <"Contact">
					description = <"A group of addresses at which the party can be reached for one purpose, with the period in which they are valid.">
				>
				["at0026"] = <
					text = <"Electronic communication">
					description = <"An electronic address, such as a telephone number, an email address or a URL.">
				>
				["at0027"] = <
					text = <"Electronic communication details">
					description = <"The structure that holds the electronic address.">
				>
				["at0028"] = <
					text = <"Electronic communication">
					description = <"The electronic address.">
				>
				["at0029"] = <
					text = <"Relationship">
					description = <"The team's membership of an organisation, such as the organisation that manages it.">
					comment = <"Corresponds to FHIR CareTeam.managingOrganization. Members are not listed here: a member records its membership of the team as a relationship of its own.">
				>
			>
		>
	>
	term_bindings = <
		["LOINC"] = <
			items = <
				["at0010"] = <[LOINC::LA27975-4]>
				["at0011"] = <[LOINC::LA27976-2]>
				["at0012"] = <[LOINC::LA27977-0]>
				["at0013"] = <[LOINC::LA27978-8]>
				["at0014"] = <[LOINC::LA28865-6]>
				["at0015"] = <[LOINC::LA28866-4]>
				["at0016"] = <[LOINC::LA27980-4]>
				["at0017"] = <[LOINC::LA28867-2]>
			>
		>
	>
