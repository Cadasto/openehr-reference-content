archetype (adl_version=1.4; uid=8db8d241-5add-4a8a-910f-d0ceb494fbbc)
	openEHR-DEMOGRAPHIC-GROUP.generic_group.v1

concept
	[at0000]	-- Group
language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["name"] = <"openehr-reference-content">
		["date"] = <"2026-11-19">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record a group of parties as a party in a demographic service: its names, identifiers, the kind of members it has, the traits they share and its electronic contacts.">
			use = <"Use for a group that has no legal or administrative standing of its own: a household, a patient cohort, a team that is not a care team, a group of devices. The group's members are not listed in the group: each member records a membership relationship to it, so the group is the target. A group may instead describe its members by the traits they share, without listing any.">
			keywords = <"group", "household", "cohort", "team", "members", "demographics">
			misuse = <"Not for an organisation or a department with a legal or administrative standing: use an ORGANISATION. Not for a care team: use the care team archetype.">
			copyright = <"© openehr-reference-content contributors">
		>
	>
	lifecycle_state = <"in_development">
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["references"] = <"Aligned with the HL7 FHIR R4 (4.0.1) resource Group (https://hl7.org/fhir/R4/).">
	>

definition
	GROUP[at0000] matches {	-- Group
		details existence matches {0..1} matches {
			ITEM_TREE[at0001] occurrences matches {1..1} matches {	-- Details
				items cardinality matches {1..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..*} matches {	-- Identifier
						value matches {
							DV_IDENTIFIER matches {*}
						}
					}
					ELEMENT[at0003] occurrences matches {0..1} matches {	-- Member type
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0004,	-- Person
									at0005,	-- Practitioner
									at0006]	-- Device
								}
							}
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0007] occurrences matches {0..1} matches {	-- Kind of group
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0008] occurrences matches {0..1} matches {	-- Actual
						value matches {
							DV_BOOLEAN matches {*}
						}
					}
					ELEMENT[at0009] occurrences matches {0..1} matches {	-- Active
						value matches {
							DV_BOOLEAN matches {*}
						}
					}
					ELEMENT[at0010] occurrences matches {0..1} matches {	-- Description
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0011] occurrences matches {0..1} matches {	-- Number of members
						value matches {
							DV_COUNT matches {*}
						}
					}
					CLUSTER[at0012] occurrences matches {0..*} matches {	-- Characteristic
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0013] occurrences matches {1..1} matches {	-- Characteristic
								value matches {
									DV_TEXT matches {*}
								}
							}
							ELEMENT[at0014] occurrences matches {1..1} matches {	-- Value
								value matches {
									DV_TEXT matches {*}
									DV_BOOLEAN matches {*}
									DV_QUANTITY matches {*}
									DV_INTERVAL<DV_QUANTITY> matches {*}
								}
							}
							ELEMENT[at0015] occurrences matches {0..1} matches {	-- Exclude
								value matches {
									DV_BOOLEAN matches {*}
								}
							}
							ELEMENT[at0016] occurrences matches {0..1} matches {	-- Period
								value matches {
									DV_INTERVAL<DV_DATE_TIME> matches {*}
								}
							}
						}
					}
					allow_archetype CLUSTER[at0017] occurrences matches {0..*} matches {	-- Additional details
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
		identities cardinality matches {1..*; unordered} matches {
			PARTY_IDENTITY[at0018] occurrences matches {1..*} matches {	-- Group name
				details matches {
					ITEM_TREE[at0019] occurrences matches {1..1} matches {	-- Name details
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0020] occurrences matches {1..1} matches {	-- Name
								value matches {
									DV_TEXT matches {*}
								}
							}
						}
					}
				}
			}
		}
		contacts existence matches {0..1} cardinality matches {0..*; unordered} matches {
			CONTACT[at0021] occurrences matches {0..*} matches {	-- Contact
				addresses cardinality matches {1..*; unordered} matches {
					ADDRESS[at0022] occurrences matches {0..*} matches {	-- Electronic communication
						details matches {
							ITEM_TREE[at0023] occurrences matches {1..1} matches {	-- Electronic communication details
								items cardinality matches {1..1; unordered} matches {
									allow_archetype CLUSTER[at0024] occurrences matches {1..1} matches {	-- Electronic communication
										include
											archetype_id/value matches {/openEHR-EHR-CLUSTER\.electronic_communication(-[a-zA-Z0-9_]+)*\.v1/}
									}
								}
							}
						}
					}
				}
			}
		}
		relationships existence matches {0..1} cardinality matches {0..*; unordered} matches {
			allow_archetype PARTY_RELATIONSHIP[at0025] occurrences matches {0..*} matches {	-- Relationship
				include
					archetype_id/value matches {/openEHR-DEMOGRAPHIC-PARTY_RELATIONSHIP\.party_membership(-[a-zA-Z0-9_]+)*\.v1/}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Group">
					description = <"A group of parties that is formed for a purpose but has no legal or administrative standing of its own, such as a household, a patient cohort or a team.">
				>
				["at0001"] = <
					text = <"Details">
					description = <"Data about the group.">
				>
				["at0002"] = <
					text = <"Identifier">
					description = <"An identifier of the group.">
					comment = <"Corresponds to FHIR Group.identifier.">
				>
				["at0003"] = <
					text = <"Member type">
					description = <"The kind of party the members of the group are.">
					comment = <"The codes are those of FHIR R4 GroupType whose members can be parties; animal, medication and substance are not. Record a group of mixed kinds as text. Corresponds to FHIR Group.type.">
				>
				["at0004"] = <
					text = <"Person">
					description = <"The members are persons, such as patients or relatives. FHIR GroupType code person.">
				>
				["at0005"] = <
					text = <"Practitioner">
					description = <"The members are care providers. FHIR GroupType code practitioner.">
				>
				["at0006"] = <
					text = <"Device">
					description = <"The members are devices or other agents. FHIR GroupType code device.">
				>
				["at0007"] = <
					text = <"Kind of group">
					description = <"What the group is, such as a household, a ward team or a study cohort.">
					comment = <"Coding is preferred, for example with SNOMED CT. Corresponds to FHIR Group.code.">
				>
				["at0008"] = <
					text = <"Actual">
					description = <"Whether the group stands for particular parties (true) or describes by its characteristics the parties that may belong to it (false).">
					comment = <"Corresponds to FHIR Group.actual. Members of an actual group record their membership of it themselves.">
				>
				["at0009"] = <
					text = <"Active">
					description = <"Whether the group's record is in use.">
					comment = <"Corresponds to FHIR Group.active.">
				>
				["at0010"] = <
					text = <"Description">
					description = <"A description of the group and its purpose.">
				>
				["at0011"] = <
					text = <"Number of members">
					description = <"How many members the group has, or had when this was recorded.">
					comment = <"Corresponds to FHIR Group.quantity.">
				>
				["at0012"] = <
					text = <"Characteristic">
					description = <"A trait that the members of the group share, or that no member has.">
					comment = <"Corresponds to FHIR Group.characteristic.">
				>
				["at0013"] = <
					text = <"Characteristic">
					description = <"The trait, such as an age band, a diagnosis or a place of residence.">
					comment = <"Coding is preferred. Corresponds to FHIR Group.characteristic.code.">
				>
				["at0014"] = <
					text = <"Value">
					description = <"The value the members have for the trait.">
					comment = <"Corresponds to FHIR Group.characteristic.value[x], whose CodeableConcept is text here and whose Range is an interval of quantities.">
				>
				["at0015"] = <
					text = <"Exclude">
					description = <"Whether the group holds the parties that do not have the trait (true) rather than those that do (false).">
					comment = <"Corresponds to FHIR Group.characteristic.exclude.">
				>
				["at0016"] = <
					text = <"Period">
					description = <"The period in which the trait applies.">
					comment = <"Corresponds to FHIR Group.characteristic.period.">
				>
				["at0017"] = <
					text = <"Additional details">
					description = <"Further details about the group that a particular use needs.">
				>
				["at0018"] = <
					text = <"Group name">
					description = <"A name by which the group is known.">
					comment = <"Corresponds to FHIR Group.name.">
				>
				["at0019"] = <
					text = <"Name details">
					description = <"The name.">
				>
				["at0020"] = <
					text = <"Name">
					description = <"The name of the group, as it is displayed.">
				>
				["at0021"] = <
					text = <"Contact">
					description = <"A group of addresses at which the party can be reached for one purpose, with the period in which they are valid.">
				>
				["at0022"] = <
					text = <"Electronic communication">
					description = <"An electronic address, such as a telephone number, an email address or a URL.">
				>
				["at0023"] = <
					text = <"Electronic communication details">
					description = <"The structure that holds the electronic address.">
				>
				["at0024"] = <
					text = <"Electronic communication">
					description = <"The electronic address.">
				>
				["at0025"] = <
					text = <"Relationship">
					description = <"The group's membership of an organisation or of another group, such as the organisation that manages it.">
					comment = <"Corresponds to FHIR Group.managingEntity, where that is an organisation. Members are not listed here: a member records its membership of the group as a relationship of its own.">
				>
			>
		>
	>
